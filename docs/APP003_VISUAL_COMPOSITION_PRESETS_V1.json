  "caseModifiers": [
    {
      "id": "case.0_locations",
      "behavior": "hide location list and location/map-only notes; enlarge poem/art, never fabricate facilities"
    },
    {
      "id": "case.3_locations",
      "behavior": "main location 01 prominent, support locations 02/03 condensed or moved to back"
    },
    {
      "id": "case.long_name",
      "behavior": "allow wrapping, never ellipsis for required names; fallback to duplex/multipage"
    },
    {
      "id": "case.high_density",
      "behavior": "move full support card bodies, notes and numbered 04-10 legend to back, preserve citations"
    },
    {
      "id": "case.duplex_map",
      "behavior": "back page uses sourced GSI tiles if available, else coordinate diagram; preserve required notes"
    },
    {
      "id": "case.mono",
      "behavior": "maintain all semantic distinctions in strokes/labels without color"
    },
    {
      "id": "case.image_unavailable",
      "behavior": "existing original SVG fallback; keep caption and copyright/disclosure accurate"
    }
  ]
